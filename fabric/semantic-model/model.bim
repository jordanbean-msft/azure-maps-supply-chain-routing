ression": "MAX(deliveries[Refreshed_UTC])", "formatString": ""}]}, {"name": "route_points", "columns": [{"name": "Delivery_ID", "dataType": "string", "sourceColumn": "Delivery_ID", "summarizeBy": "none"}, {"name": "Path_ID", "dataType": "string", "sourceColumn": "Path_ID", "summarizeBy": "none"}, {"name": "Route_segment", "dataType": "int64", "sourceColumn": "Route_segment", "summarizeBy": "none"}, {"name": "Point_sequence", "dataType": "int64", "sourceColumn": "Point_sequence", "summarizeBy": "none"}, {"name": "Longitude", "dataType": "double", "sourceColumn": "Longitude", "summarizeBy": "none", "dataCategory": "Longitude"}, {"name": "Latitude", "dataType": "double", "sourceColumn": "Latitude", "summarizeBy": "none", "dataCategory": "Latitude"}], "partitions": [{"name": "route_points", "mode": "directLake", "source": {"type": "entity", "entityName": "route_points", "schemaName": "dbo", "expressionSource": "DatabaseQuery"}}]}], "relationships": [{"name": "delivery_route_points", "fromTable": "route_points", "fromColumn": "Delivery_ID", "fromCardinality": "many", "toTable": "deliveries", "toColumn": "Delivery_ID", "toCardinality": "one", "crossFilteringBehavior": "bothDirections"}]}}