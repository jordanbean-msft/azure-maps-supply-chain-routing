# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# uv / pip
.venv/
*.egg-info/
dist/
build/

# Environment files (never commit real secrets)
.env

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Linting caches
.ruff_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# Runtime logs
*.log

# Local Azure state from the archived application
.azure/

# Local dependencies and outputs from the archived application
node_modules/
frontend/coverage/
frontend/
infra/
.cache/

# Download security metadata (not workbook content)
*:sec.endpointdlp

# IDE
.idea/
*.swp
*.swo

# Python version override (already tracked via .python-version)
.python-version.local
