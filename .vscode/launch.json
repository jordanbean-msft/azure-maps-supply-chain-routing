{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fabric: deploy delivery carbon analytics",
      "type": "debugpy",
      "request": "launch",
      "module": "template_repository.fabric.cli",
      "args": ["deploy"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "preLaunchTask": "sync-venv",
      "justMyCode": true
    },
    {
      "name": "Sample: delivery carbon CSV script",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/sample/houston_delivery_co2.py",
      "args": ["--help"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "preLaunchTask": "sync-venv",
      "justMyCode": true
    },
    {
      "name": "Tests: all (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "-W", "error"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "preLaunchTask": "sync-venv",
      "justMyCode": false
    }
  ]
}
