{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "template_repository.main",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": { "AZURE_ENVIRONMENT": "debug" },
      "preLaunchTask": "sync-venv",
      "justMyCode": true
    },
    {
      "name": "Tests: all (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "-W", "error"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "preLaunchTask": "sync-venv",
      "justMyCode": false
    },
    {
      "name": "Web: React (Vite)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "frontend:dev"
    }
  ]
}
