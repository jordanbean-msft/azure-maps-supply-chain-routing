{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "sync-venv",
      "type": "shell",
      "command": "uv sync --extra dev",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "uv build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "fabric:deploy",
      "type": "shell",
      "command": "uv run python -m template_repository.fabric.cli deploy",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "fabric:refresh",
      "type": "shell",
      "command": "uv run python -m template_repository.fabric.cli refresh",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "fabric:publish-report",
      "type": "shell",
      "command": "uv run python -m template_repository.fabric.cli publish-report",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "fabric:status",
      "type": "shell",
      "command": "uv run python -m template_repository.fabric.cli status",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "sample:help",
      "type": "shell",
      "command": "uv run python sample/houston_delivery_co2.py --help",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "fabric:test",
      "type": "shell",
      "command": "uv run pytest tests/test_fabric.py tests/test_fabric_notebook.py -W error",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "uv run pytest",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "test-strict",
      "type": "shell",
      "command": "uv run pytest -W error",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "coverage",
      "type": "shell",
      "command": "uv run pytest --cov --cov-report=xml --cov-report=term-missing",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "uv run ruff check .",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "lint-fix",
      "type": "shell",
      "command": "uv run ruff check . --fix && uv run ruff format .",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "format",
      "type": "shell",
      "command": "uv run ruff format .",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "format-check",
      "type": "shell",
      "command": "uv run ruff format --check .",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "type-check",
      "type": "shell",
      "command": "uv run mypy src/",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "validate",
      "dependsOn": ["lint", "format-check", "type-check", "test-strict"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "pre-commit-install",
      "type": "shell",
      "command": "uv run pre-commit install && uv run pre-commit install --hook-type pre-push",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "az-login",
      "type": "shell",
      "command": "az login",
      "group": "none",
      "problemMatcher": []
    }
  ]
}
