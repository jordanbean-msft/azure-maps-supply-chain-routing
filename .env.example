# Copy to .env. Demo mode needs no Azure credentials and uses simulated routing.
APP_MODE=demo
AZURE_ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
AUTH_ENABLED=false

# Entra user sign-in (independent of Maps and workload managed identities).
# Terraform enables this in Azure. For local sign-in, register the local SPA
# redirect origin with trailing slash and set these nonsecret values:
# AUTH_ENABLED=true
# ENTRA_TENANT_ID=<tenant-id>
# ENTRA_CLIENT_ID=<spa-and-api-app-registration-client-id>
# ENTRA_API_SCOPE=<full-delegated-access_as_user-scope-uri>

# Live backend: requires provisioned resources; never falls back to simulation.
# Set APP_MODE=live and AZURE_ENVIRONMENT=production.
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>
# AZURE_MAPS_CLIENT_ID=<azure-maps-account-client-id>
# AZURE_MAPS_ENDPOINT=https://atlas.microsoft.com
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_DATABASE=supply-chain-routing
# COSMOS_CONTAINER=scenarios
# SNAPSHOT_TTL_SECONDS=3600
# SCENARIO_TTL_SECONDS=86400
# ALLOW_DEVELOPER_CREDENTIALS=true
# MAPS_BROWSER_CLIENT_ID=<separate-render-only-managed-identity-client-id>
# MAPS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# MAPS_CACHE_SECONDS=300
# RUN_TIMEOUT_SECONDS=180
# MAX_CONCURRENT_RUNS=2
# REQUESTS_PER_MINUTE=120
# EXPENSIVE_REQUESTS_PER_MINUTE=10
# MAX_REQUEST_BYTES=65536
# TELEMETRY_ENABLED=false
# APPLICATIONINSIGHTS_CONNECTION_STRING=<application-insights-exporter-setting>
# REFRESH_ENABLED=false
# REFRESH_MAX_SCENARIOS=5

# Web container only; no trailing slash. Local Vite proxies to localhost:8000.
# API_INTERNAL_URL=https://<api-internal-container-app-hostname>
# API_PROXY_TARGET=http://127.0.0.1:8000
