# Copy to .env. Demo mode needs no Azure credentials and uses simulated routing.
APP_MODE=demo
AZURE_ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Later live backend: set APP_MODE=live and AZURE_ENVIRONMENT=production.
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>
# AZURE_MAPS_CLIENT_ID=<azure-maps-account-client-id>
# AZURE_MAPS_ENDPOINT=https://atlas.microsoft.com
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_DATABASE=supply-chain-routing
# COSMOS_CONTAINER=scenarios
# SNAPSHOT_TTL_SECONDS=3600
# SCENARIO_TTL_SECONDS=86400

# Web container only; no trailing slash. Local Vite proxies to localhost:8000.
# API_INTERNAL_URL=https://<api-internal-container-app-hostname>
