{
  "azure": {
    "subscription_id": "${AZURE_SUBSCRIPTION_ID}",
    "tenant_id": "${AZURE_TENANT_ID}",
    "location": "${AZURE_LOCATION}",
    "environment_name": "${AZURE_ENV_NAME}",
    "resource_group_name": "${AZURE_RESOURCE_GROUP}",
    "principal_id": "${AZURE_PRINCIPAL_ID}"
  },
  "naming": {"project_name": "scroute"},
  "public_network_access_enabled": "${PUBLIC_NETWORK_ACCESS_ENABLED}",
  "network": {
    "infrastructure_subnet_id": "${ACA_INFRASTRUCTURE_SUBNET_ID}",
    "private_endpoint_subnet_id": "${PRIVATE_ENDPOINT_SUBNET_ID}"
  },
  "monitoring": {
    "workspace_sku": "PerGB2018",
    "retention_days": 30,
    "daily_quota_gb": 1,
    "application_type": "web",
    "insights_retention_days": 90,
    "insights_daily_cap_gb": 1,
    "sampling_percentage": 100
  },
  "registry": {"sku": "Premium"},
  "maps": {"sku_name": "G2", "extra_allowed_origins": []},
  "authentication": {"extra_spa_redirect_uris": []},
  "cosmos": {
    "offer_type": "Standard",
    "kind": "GlobalDocumentDB",
    "consistency_level": "Session",
    "database_name": "supply-chain",
    "container_name": "scenarios",
    "partition_key_paths": ["/scenario_id"],
    "partition_key_version": 2,
    "default_ttl_seconds": 86400,
    "minimal_tls_version": "Tls12",
    "backup_type": "Periodic",
    "backup_interval_minutes": 240,
    "backup_retention_hours": 8,
    "backup_storage_redundancy": "Local"
  },
  "workloads": {
    "bootstrap_image": "mcr.microsoft.com/devcontainers/python@sha256:7876580dc67fd460fd962f004cbeb480027e9bbc0657096f1087db11f9eaff39",
    "revision_mode": "Single",
    "workload_profile_name": "Consumption",
    "workload_profile_type": "Consumption",
    "transport": "http",
    "logs_destination": "azure-monitor",
    "api_cpu": 0.5,
    "api_memory": "1Gi",
    "api_min_replicas": 1,
    "api_max_replicas": 1,
    "api_port": 8000,
    "web_cpu": 0.25,
    "web_memory": "0.5Gi",
    "web_min_replicas": 0,
    "web_max_replicas": 2,
    "web_port": 8080,
    "http_concurrent_requests": 20,
    "max_inactive_revisions": 2,
    "probe_initial_delay_seconds": 10,
    "probe_interval_seconds": 10,
    "probe_timeout_seconds": 3,
    "probe_failure_threshold": 3,
    "startup_failure_threshold": 30,
    "readiness_success_threshold": 1,
    "refresh_cpu": 0.5,
    "refresh_memory": "1Gi",
    "refresh_cron": "*/30 * * * *",
    "refresh_timeout_seconds": 960,
    "refresh_retry_limit": 1,
    "refresh_parallelism": 1,
    "refresh_completion_count": 1,
    "refresh_enabled": true,
    "refresh_max_scenarios": 5,
    "identity_propagation_duration": "60s",
    "app_mode": "live",
    "telemetry_enabled": true,
    "backend_env": {
      "SNAPSHOT_TTL_SECONDS": "3600",
      "SCENARIO_TTL_SECONDS": "86400",
      "RUN_TIMEOUT_SECONDS": "180",
      "MAX_CONCURRENT_RUNS": "2",
      "REQUESTS_PER_MINUTE": "120",
      "EXPENSIVE_REQUESTS_PER_MINUTE": "10",
      "MAPS_CACHE_SECONDS": "300",
      "MAX_REQUEST_BYTES": "65536",
      "ALLOW_DEVELOPER_CREDENTIALS": "false"
    }
  },
  "tags": {}
}
