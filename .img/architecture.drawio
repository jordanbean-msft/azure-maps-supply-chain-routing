<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" compressed="false">
  <diagram id="runtime" name="Runtime">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="1060" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Supply Chain Routing | Runtime" style="text;align=left;fontFamily=Arial;fontSize=24;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1450" height="50" as="geometry"/></mxCell>
        <mxCell id="browser" value="Browser&#xa;React + Fluent UI v9&#xa;MSAL + Azure Maps SDK&#xa;Scenario editor / route inspection&#xa;API bearer tokens in headers" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#f0f6ff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="entra" value="Microsoft Entra ID&#xa;Single-tenant SPA / API&#xa;PKCE + Microsoft SSO cookie" style="rounded=0;whiteSpace=wrap;align=left;spacingLeft=70;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#7f56a5;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="entra-icon" style="shape=image;image=img/lib/azure2/identity/Azure_Active_Directory.svg;aspect=fixed;" vertex="1" parent="entra"><mxGeometry x="15" y="35" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="graph" value="Microsoft Graph&#xa;Delegated User.Read&#xa;Own name + profile photo&#xa;Optional; memory only" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#7f56a5;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="aca" value="Azure Container Apps environment | Consumption" style="swimlane;startSize=40;rounded=0;container=1;pointerEvents=0;align=left;spacingLeft=16;fontFamily=Arial;fontSize=16;fillColor=#eaf3fb;swimlaneFillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="660" height="590" as="geometry"/></mxCell>
        <mxCell id="web" value="Web Container App&#xa;Non-root Nginx :8080&#xa;Static SPA + same-origin proxy&#xa;SSE buffering disabled&#xa;Web identity: image pull only" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="aca"><mxGeometry x="30" y="100" width="230" height="140" as="geometry"/></mxCell>
        <mxCell id="api" value="API Container App&#xa;Internal FastAPI :8000&#xa;JWT validation + token broker&#xa;Routing + min-cost-flow solver&#xa;API / browser identities" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="aca"><mxGeometry x="370" y="100" width="230" height="140" as="geometry"/></mxCell>
        <mxCell id="job" value="Scheduled refresh job&#xa;Same deployed API image&#xa;Every 30 minutes (UTC)&#xa;Up to five eligible scenarios&#xa;Independent refresh identity" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="aca"><mxGeometry x="370" y="370" width="230" height="140" as="geometry"/></mxCell>
        <mxCell id="services" value="Managed Azure services" style="swimlane;startSize=40;rounded=0;container=1;pointerEvents=0;align=left;spacingLeft=16;fontFamily=Arial;fontSize=16;fillColor=#eaf3fb;swimlaneFillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="1150" y="100" width="360" height="820" as="geometry"/></mxCell>
        <mxCell id="maps" value="Azure Maps | G2&#xa;REST: geocode, matrix, directions&#xa;Traffic + route weather&#xa;Browser: render / traffic only&#xa;No account-key authentication" style="rounded=0;whiteSpace=wrap;align=left;spacingLeft=70;spacingRight=12;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;container=1;pointerEvents=0;" vertex="1" parent="services"><mxGeometry x="40" y="100" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="maps-icon" style="shape=image;image=img/lib/azure2/iot/Azure_Maps_Accounts.svg;aspect=fixed;" vertex="1" parent="maps"><mxGeometry x="15" y="50" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="cosmos" value="Cosmos DB for NoSQL&#xa;Serverless; session consistency&#xa;Partition: /scenario_id&#xa;ETag concurrency + TTL&#xa;Native data-plane RBAC" style="rounded=0;whiteSpace=wrap;align=left;spacingLeft=70;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;container=1;pointerEvents=0;" vertex="1" parent="services"><mxGeometry x="40" y="390" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="cosmos-icon" style="shape=image;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;aspect=fixed;" vertex="1" parent="cosmos"><mxGeometry x="15" y="45" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="monitor" value="Azure Monitor&#xa;Application Insights&#xa;Log Analytics workspace&#xa;Structured logs + traces&#xa;Service diagnostics" style="rounded=0;whiteSpace=wrap;align=left;spacingLeft=70;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;container=1;pointerEvents=0;" vertex="1" parent="services"><mxGeometry x="40" y="650" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="monitor-icon" style="shape=image;image=img/lib/azure2/devops/Application_Insights.svg;aspect=fixed;" vertex="1" parent="monitor"><mxGeometry x="15" y="45" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="e-web" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.32;" edge="1" parent="1" source="browser" target="web"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-api" value="Internal HTTPS" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="web" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-login" value="PKCE / SSO" style="edgeStyle=orthogonalEdgeStyle;startArrow=block;endArrow=block;strokeColor=#7f56a5;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="browser" target="entra"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-profile" value="Separate Graph token" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#7f56a5;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="browser" target="graph"><mxGeometry x="0.45" relative="1" as="geometry"><Array as="points"><mxPoint x="10" y="300"/><mxPoint x="10" y="775"/></Array><mxPoint x="95" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-tiles" value="Direct browser render / traffic tiles" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=0;entryY=0.65;" edge="1" parent="1" source="browser" target="maps"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="400"/><mxPoint x="1090" y="400"/><mxPoint x="1090" y="298"/></Array></mxGeometry></mxCell>
        <mxCell id="e-routes" value="Routing / weather REST" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="api" target="maps"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-store" value="Point reads / writes" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.3;" edge="1" parent="1" source="api" target="cosmos"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="312"/><mxPoint x="1070" y="532"/></Array></mxGeometry></mxCell>
        <mxCell id="e-jobmaps" value="Refresh" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0;entryY=0.9;" edge="1" parent="1" source="job" target="maps"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="498"/><mxPoint x="1120" y="335"/></Array></mxGeometry></mxCell>
        <mxCell id="e-jobstore" value="Snapshots" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=0;entryY=0.75;" edge="1" parent="1" source="job" target="cosmos"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-logs" value="Console / platform logs + API / job traces" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#616161;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.8;" edge="1" parent="1" source="aca" target="monitor"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="910"/><mxPoint x="1120" y="910"/><mxPoint x="1120" y="862"/></Array></mxGeometry></mxCell>
        <mxCell id="note" value="Public demo topology. Only web ingress is internet-facing; the API still validates every user token.&#xa;Blue: application/data traffic. Purple: user identity. Dashed: optional profile / telemetry.&#xa;Private mode requires existing subnets and policy-managed DNS; Azure Maps still needs public HTTPS egress.&#xa;Demo mode replaces cloud routing/storage with deterministic simulation and memory; it does not claim live observations." style="text;whiteSpace=wrap;align=left;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1470" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="identity" name="Identity">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1510" pageHeight="1090" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Supply Chain Routing | Trust and identity" style="text;align=left;fontFamily=Arial;fontSize=24;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="50" as="geometry"/></mxCell>
        <mxCell id="browser" value="Signed-in browser&#xa;MSAL authorization code + PKCE&#xa;API cache: localStorage&#xa;Conditional cookie-backed SSO&#xa;Explicit sign-out locks other tabs&#xa;No app-managed token cookies" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#f0f6ff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="270" height="220" as="geometry"/></mxCell>
        <mxCell id="entra" value="Microsoft Entra ID&#xa;One single-tenant SPA / API&#xa;Delegated access_as_user&#xa;Exact web-origin / redirect&#xa;Tenant consent + MFA apply&#xa;No client secret / implicit grant" style="rounded=0;whiteSpace=wrap;align=left;spacingLeft=70;spacingRight=10;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#7f56a5;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="450" y="150" width="290" height="220" as="geometry"/></mxCell>
        <mxCell id="entra-icon" style="shape=image;image=img/lib/azure2/identity/Azure_Active_Directory.svg;aspect=fixed;" vertex="1" parent="entra"><mxGeometry x="15" y="80" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="api" value="FastAPI security boundary&#xa;Via Nginx + internal HTTPS&#xa;RS256 signature / cached JWKS&#xa;Issuer, tenant, audience, expiry&#xa;Delegated access_as_user required&#xa;Health + auth discovery public" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#f0f6ff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="300" height="220" as="geometry"/></mxCell>
        <mxCell id="graph" value="Microsoft Graph&#xa;Separate delegated User.Read token&#xa;Own profile / photo; optional consent&#xa;Graph token caching disabled&#xa;Profile artifacts stay in memory" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#7f56a5;" vertex="1" parent="1"><mxGeometry x="450" y="480" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="workload" value="Workload identities | Not signed-in user credentials" style="swimlane;startSize=40;rounded=0;container=1;pointerEvents=0;align=left;spacingLeft=16;fontFamily=Arial;fontSize=16;fillColor=#eaf3fb;swimlaneFillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="860" y="450" width="600" height="420" as="geometry"/></mxCell>
        <mxCell id="service-mi" value="API / refresh identities&#xa;Maps Data Reader&#xa;Cosmos Data Contributor&#xa;Container-scoped data access" style="rounded=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="workload"><mxGeometry x="30" y="80" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="cosmos" value="Cosmos NoSQL container&#xa;Native SQL data-plane RBAC&#xa;No browser credentials&#xa;No account-key authentication" style="rounded=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="workload"><mxGeometry x="320" y="80" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="browser-mi" value="Separate browser Maps identity&#xa;Attached to API token broker&#xa;Only render/read + traffic/read&#xa;No route / weather / search rights" style="rounded=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="workload"><mxGeometry x="30" y="260" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="maps" value="Azure Maps account&#xa;Backend: routing + weather&#xa;Browser: tiles + traffic&#xa;Account-scoped data roles&#xa;Exact browser-origin allowlist" style="rounded=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="workload"><mxGeometry x="320" y="260" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="e-login" value="PKCE / SSO" style="edgeStyle=orthogonalEdgeStyle;startArrow=block;endArrow=block;strokeColor=#7f56a5;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="browser" target="entra"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-userapi" value="Delegated API bearer token (also SSE)" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=1;entryY=0.2;" edge="1" parent="1" source="browser" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="100"/><mxPoint x="1210" y="100"/><mxPoint x="1210" y="194"/></Array></mxGeometry></mxCell>
        <mxCell id="e-jwks" value="OIDC / JWKS" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#7f56a5;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="api" target="entra"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-graph" value="Separate Graph token" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#7f56a5;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="browser" target="graph"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="348"/><mxPoint x="350" y="555"/></Array><mxPoint x="-80" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-api-mi" value="API selects its UAMI" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#616161;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="api" target="service-mi"><mxGeometry x="-0.5" relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="410"/><mxPoint x="830" y="410"/><mxPoint x="830" y="595"/></Array></mxGeometry></mxCell>
        <mxCell id="e-broker" value="Token broker" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#616161;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="api" target="browser-mi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="348"/><mxPoint x="810" y="770"/></Array></mxGeometry></mxCell>
        <mxCell id="e-data" value="RBAC" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#616161;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="service-mi" target="cosmos"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-reader" value="Maps Data Reader" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#616161;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;entryX=0.5;entryY=0;" edge="1" parent="1" source="service-mi" target="maps"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="690"/><mxPoint x="1305" y="690"/></Array></mxGeometry></mxCell>
        <mxCell id="e-tile-role" value="Tiles" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#616161;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="browser-mi" target="maps"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-sdk" value="SDK uses short-lived brokered token directly for render / traffic" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="browser" target="maps"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="175" y="940"/><mxPoint x="1305" y="940"/></Array></mxGeometry></mxCell>
        <mxCell id="note" value="Solid: user/application traffic. Dashed: trust metadata or workload authorization. UAMI = user-assigned managed identity.&#xa;Signed-in tenant users share scenarios; ownership authorization is not implemented. Use synthetic data only.&#xa;Microsoft SSO cookie and MSAL cache are separate; browser privacy, expiry, consent and Conditional Access can require sign-in.&#xa;API, web and refresh also have registry-scoped AcrPull; the browser identity does not. CI OIDC is a separate deployment principal." style="text;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=14;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1420" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="planning" name="Planning and data">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1660" pageHeight="1060" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Supply Chain Routing | Planning and persisted data" style="text;align=left;fontFamily=Arial;fontSize=24;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1580" height="50" as="geometry"/></mxCell>
        <mxCell id="input" value="1. Saved scenario&#xa;Supplier quantities + coordinates&#xa;Factory receiving capacities&#xa;Departure / truck / cost profile&#xa;Validated disruption targets&#xa;Save uses an exact ETag" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#f0f6ff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="260" height="160" as="geometry"/></mxCell>
        <mxCell id="run" value="2. Submit run&#xa;POST optimize returns 202&#xa;Frozen scenario snapshot&#xa;Optional Idempotency-Key&#xa;Bounded asyncio task&#xa;Stages persist before streaming" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="370" y="140" width="260" height="160" as="geometry"/></mxCell>
        <mxCell id="routes" value="3. Acquire candidates&#xa;Cache hit OR Azure Maps&#xa;Matrix: all reachable pairs&#xa;Directions: up to two per pair&#xa;Traffic duration + road geometry&#xa;Weather along each actual path" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="260" height="160" as="geometry"/></mxCell>
        <mxCell id="cost" value="4. Cost each candidate&#xa;Distance / driver / toll / fuel&#xa;Carbon / traffic / weather&#xa;Simulated disruption penalty&#xa;Exclude closed candidates&#xa;Itemized cost per shipment unit" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="1030" y="140" width="260" height="160" as="geometry"/></mxCell>
        <mxCell id="solver" value="5. OR-Tools min-cost flow&#xa;Minimize quantity x unit cost&#xa;Assign all supplier supply&#xa;Do not exceed factory capacity&#xa;0.001 quantity / cost precision&#xa;Completed or infeasible result" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#f0f6ff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="1360" y="140" width="260" height="160" as="geometry"/></mxCell>
        <mxCell id="geocode" value="Optional address lookup&#xa;Explicit geocode API action&#xa;Choose coordinates, then save&#xa;Not run automatically by optimizer" style="rounded=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#616161;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="browser" value="Browser observes the run through FastAPI&#xa;Authenticated fetch SSE: persisted stage / progress events&#xa;GET run: complete routes, allocations, costs and warnings&#xa;2.5-second polling watchdog; no automatic SSE reconnect loop&#xa;Blue = recommendation; purple = inspection; magenta = preview&#xa;Inspecting / animating a route does not change allocations" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#f0f6ff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="650" height="170" as="geometry"/></mxCell>
        <mxCell id="bounds" value="Two concurrent runs; 180-second deadline; one API replica.&#xa;10 suppliers x 3 factories: up to 30 reachable pairs / 60 routes.&#xa;Cold maximum: 91 upstream HTTP calls before retries.&#xa;Matrix transactions are billed by cells, not just HTTP requests.&#xa;No durable queue, fleet dispatch, carrier quotes or live vehicle tracking." style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#616161;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="650" height="130" as="geometry"/></mxCell>
        <mxCell id="data" value="One Cosmos container | /scenario_id partition" style="swimlane;startSize=40;rounded=0;container=1;pointerEvents=0;align=left;spacingLeft=16;fontFamily=Arial;fontSize=16;fillColor=#eaf3fb;swimlaneFillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="900" y="470" width="720" height="450" as="geometry"/></mxCell>
        <mxCell id="scenario-doc" value="kind: scenario&#xa;Locations / costs / disruptions embedded&#xa;Scenario ETag + 24-hour TTL&#xa;No separate location documents" style="rounded=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="data"><mxGeometry x="30" y="70" width="280" height="135" as="geometry"/></mxCell>
        <mxCell id="run-doc" value="kind: run&#xa;Immutable input snapshot + deadline&#xa;Run status / stage / progress&#xa;Routes / allocations / costs / warnings&#xa;Ordered events embedded in this document&#xa;ETag writes; one-hour snapshot TTL" style="rounded=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="data"><mxGeometry x="360" y="70" width="330" height="170" as="geometry"/></mxCell>
        <mxCell id="cache" value="kind: maps_cache / geocode&#xa;Routes + warnings: five-minute TTL&#xa;Geocode results: one-hour TTL&#xa;Scoped to the same scenario partition" style="rounded=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="data"><mxGeometry x="30" y="260" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="markers" value="kind: latest / active&#xa;Latest run pointer: one-hour TTL&#xa;Refresh eligibility marker: 24-hour TTL&#xa;Refresh does not re-mark itself active" style="rounded=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="data"><mxGeometry x="360" y="280" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="e-input" value="Calculate" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="input" target="run"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-route" value="Route" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="run" target="routes"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-cost" value="Enrich" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="routes" target="cost"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-solve" value="Solve" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cost" target="solver"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-geocode" value="Choose / save" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#616161;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="geocode" target="input"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-persist" value="Snapshot + stages" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="run" target="run-doc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="578" y="380"/><mxPoint x="1340" y="380"/><mxPoint x="1340" y="520"/><mxPoint x="1230" y="520"/><mxPoint x="1230" y="625"/></Array></mxGeometry></mxCell>
        <mxCell id="e-result" value="Persist results" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="solver" target="run-doc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-cache" value="Cache lookup / write" style="edgeStyle=orthogonalEdgeStyle;startArrow=block;endArrow=block;dashed=1;strokeColor=#616161;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="routes" target="cache"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="793"/></Array></mxGeometry></mxCell>
        <mxCell id="e-progress" value="GET run / events" style="edgeStyle=orthogonalEdgeStyle;startArrow=block;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.6;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="1" source="browser" target="run"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Current defaults from infra/main.tfvars.json. Cache/signature and persisted document kinds reflect implementation, not the original planning sketch.&#xa;Routing duration includes traffic. ETA adds only weather and simulated delays. Unavailable weather / unpriced tolls remain explicit warnings.&#xa;The browser talks only to FastAPI and authorized Maps tiles; it never reads Cosmos directly. TTL is asynchronous cleanup, not a backup or spending cap." style="text;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=14;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="1580" height="75" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="deployment" name="Delivery and operations">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1580" pageHeight="1120" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Supply Chain Routing | Delivery and operations" style="text;align=left;fontFamily=Arial;fontSize=24;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1490" height="50" as="geometry"/></mxCell>
        <mxCell id="repo" value="GitHub repository&#xa;Python / React / Terraform&#xa;Lockfiles + tests + docs&#xa;Push / pull request to main" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#616161;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="ci" value="CI (does not deploy)&#xa;Python: lint / format / types / tests&#xa;React: lint / format / types / tests&#xa;Terraform: validate / mocks / hooks&#xa;Container builds (push: false)&#xa;Chromium integration workflows&#xa;No Azure user impersonation" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#f0f6ff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="390" y="120" width="300" height="250" as="geometry"/></mxCell>
        <mxCell id="manual" value="Manual deployment workflows&#xa;workflow_dispatch + azd environment&#xa;Operator review after CI&#xa;Azure CLI + azd OIDC federation&#xa;No deployment client secrets&#xa;GitHub env / federation are prerequisites" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#7f56a5;" vertex="1" parent="1"><mxGeometry x="390" y="520" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="oidc" value="Deployment principal&#xa;Entra GitHub OIDC trust&#xa;Control plane + state access&#xa;Separate from SPA / API users" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#7f56a5;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="acr" value="Azure Container Registry&#xa;Premium; no admin keys&#xa;ACR Tasks remote builds&#xa;Immutable deployment tags&#xa;Workloads: AcrPull&#xa;Deployer: AcrPush" style="rounded=0;whiteSpace=wrap;align=left;spacingLeft=70;spacingRight=12;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="280" height="180" as="geometry"/></mxCell>
        <mxCell id="acr-icon" style="shape=image;image=img/lib/azure2/containers/Container_Registries.svg;aspect=fixed;" vertex="1" parent="acr"><mxGeometry x="15" y="65" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="tf" value="azd provision + Terraform&#xa;Pre-created application group&#xa;Direct azurerm / AzureAD resources&#xa;Service identities + narrow RBAC&#xa;Runtime outputs feed azd deployment&#xa;No state or service keys in Git" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="800" y="500" width="280" height="240" as="geometry"/></mxCell>
        <mxCell id="aca" value="Container Apps | Consumption" style="swimlane;startSize=40;rounded=0;container=1;pointerEvents=0;align=left;spacingLeft=16;fontFamily=Arial;fontSize=16;fillColor=#eaf3fb;swimlaneFillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="1180" y="100" width="360" height="600" as="geometry"/></mxCell>
        <mxCell id="web" value="Web | 0.25 CPU / 0.5 GiB&#xa;0-2 replicas; non-root Nginx&#xa;Public demo ingress :8080" style="rounded=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="aca"><mxGeometry x="30" y="90" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="api" value="API | 0.5 CPU / 1 GiB&#xa;Exactly one warm replica&#xa;Internal ingress :8000" style="rounded=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="aca"><mxGeometry x="30" y="270" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="job" value="Refresh | 0.5 CPU / 1 GiB&#xa;*/30 * * * * (UTC); five scenarios&#xa;960s execution limit; one retry" style="rounded=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="aca"><mxGeometry x="30" y="450" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="support" value="Provisioned data and monitoring" style="swimlane;startSize=40;rounded=0;container=1;pointerEvents=0;align=left;spacingLeft=16;fontFamily=Arial;fontSize=16;fillColor=#eaf3fb;swimlaneFillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="650" height="220" as="geometry"/></mxCell>
        <mxCell id="cosmos" value="Cosmos NoSQL&#xa;Serverless + TTL&#xa;Native data RBAC" style="rounded=0;whiteSpace=wrap;align=left;spacing=10;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="support"><mxGeometry x="20" y="70" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="maps" value="Azure Maps G2&#xa;Render / traffic role&#xa;Backend Data Reader" style="rounded=0;whiteSpace=wrap;align=left;spacing=10;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="support"><mxGeometry x="230" y="70" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="monitor" value="Insights + workspace&#xa;Diagnostics / traces&#xa;Failure-anomaly alert" style="rounded=0;whiteSpace=wrap;align=left;spacing=10;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;" vertex="1" parent="support"><mxGeometry x="440" y="70" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="state" value="Pre-created Azure Blob state&#xa;Separate state resource group&#xa;Entra Storage Blob Data Contributor&#xa;provider.conf.json placeholders&#xa;Never commit generated state" style="rounded=0;whiteSpace=wrap;align=left;spacingLeft=70;spacingRight=10;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#0078d4;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="800" y="860" width="350" height="170" as="geometry"/></mxCell>
        <mxCell id="state-icon" style="shape=image;image=img/lib/azure2/storage/Storage_Accounts.svg;aspect=fixed;" vertex="1" parent="state"><mxGeometry x="15" y="60" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="private" value="Optional private mode&#xa;Existing ACA + endpoint subnets&#xa;Premium ACR / Cosmos / Monitor PEs&#xa;DINE manages private DNS groups&#xa;Maps needs public HTTPS egress" style="rounded=0;whiteSpace=wrap;align=left;spacing=16;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#616161;" vertex="1" parent="1"><mxGeometry x="1180" y="860" width="360" height="170" as="geometry"/></mxCell>
        <mxCell id="e-ci" value="Validate" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="repo" target="ci"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-review" value="Review / dispatch (not automatic)" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#616161;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ci" target="manual"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-oidc" value="Federation" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#7f56a5;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="oidc" target="manual"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-provision" value="Provision" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" edge="1" parent="1" source="manual" target="tf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-build" value="azd deploy: remote build" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="manual" target="acr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="672"/><mxPoint x="740" y="240"/></Array><mxPoint x="40" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-acr" value="Provision / RBAC" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#616161;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="tf" target="acr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-webimage" value="Pull web image" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="acr" target="web"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-apiimage" value="Pull API image" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="acr" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="294"/><mxPoint x="1130" y="415"/></Array></mxGeometry></mxCell>
        <mxCell id="e-jobimage" value="Postdeploy hook pins same API image" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="api" target="job"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-resources" value="Workloads" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#616161;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.93;" edge="1" parent="1" source="tf" target="aca"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-support" value="Data / monitoring / roles" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#616161;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.85;entryX=1;entryY=0.5;" edge="1" parent="1" source="tf" target="support"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="704"/><mxPoint x="750" y="930"/></Array><mxPoint x="-15" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-state" value="Entra remote state" style="edgeStyle=orthogonalEdgeStyle;startArrow=block;endArrow=block;strokeColor=#0078d4;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="1" source="tf" target="state"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Provisioning uses bootstrap images; deployment replaces explicit entrypoints and synchronizes the refresh image. Wait for ready revisions before smoke tests.&#xa;Resource group, remote state, network and DNS are external prerequisites. The authorized SecurityControl=Ignore demo tag is not production guidance." style="text;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=14;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="1500" height="45" as="geometry"/></mxCell>
